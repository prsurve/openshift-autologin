{
  "manifest_version": 3,
  "name": "OpenShift Auto-Login",
  "version": "3.2.1",
  "description": "Auto-login to multiple OpenShift and vSphere clusters with modern UI",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "browsingData"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenShift Auto-Login",
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon32.png", "icon48.png", "icon128.png"],
      "matches": ["https://*/*"]
    }
  ]
}
